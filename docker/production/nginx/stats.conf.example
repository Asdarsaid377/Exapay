# Server block Nginx host untuk dashboard & skrip analitik Umami (docker-compose.analytics.yml, 127.0.0.1:8091).
#   sudo cp docker/production/nginx/stats.conf.example /etc/nginx/conf.d/exapay-stats.conf
#   sudo nginx -t && sudo systemctl reload nginx && sudo certbot --nginx -d stats.solvexaerp.tech
server {
    listen 80;
    listen [::]:80;
    server_name stats.solvexaerp.tech;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Umami membaca IP pengunjung untuk negara & sesi (di-hash, tidak disimpan mentah)
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
