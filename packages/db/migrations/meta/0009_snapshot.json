          "value": "(\"employees\".\"employment_status\" = 'contract') = (\"employees\".\"contract_end_date\" IS NOT NULL) AND (\"employees\".\"contract_end_date\" IS NULL OR \"employees\".\"contract_end_date\" >= \"employees\".\"join_date\")"
