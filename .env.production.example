# Env PRODUCTION (feature 38). Salin ke .env.production di VPS (JANGAN di-commit), isi, lalu:
#   chmod 600 .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Secret acak: `openssl rand -hex 32` (hex → aman di dalam URL koneksi). Kunci enkripsi: `openssl rand -base64 32`.
# Simpan salinan file ini (terutama DATA_ENCRYPTION_KEY & RESTIC_PASSWORD) di password manager — tanpa keduanya
# backup tidak bisa dipulihkan / data terenkripsi tidak bisa dibaca.

# ---- Domain & HTTPS (Caddy, Let's Encrypt) ----
# DNS A/AAAA domain ini harus menunjuk ke IP VPS sebelum start (port 80 & 443 terbuka)
APP_DOMAIN=app.contoh.co.id
ACME_EMAIL=admin@contoh.co.id

# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=exapayroll
APP_OWNER_PASSWORD=
APP_USER_PASSWORD=

# ---- Auth ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Enkripsi kolom sensitif (NIK, NPWP, rekening) — JANGAN diganti setelah ada data ----
DATA_ENCRYPTION_KEY=

# ---- Storage internal (SeaweedFS) ----
S3_REGION=us-east-1
S3_BUCKET=exapay
# Identitas aplikasi (hanya bucket di atas)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Identitas baca-saja untuk service backup
STORAGE_BACKUP_ACCESS_KEY_ID=
STORAGE_BACKUP_SECRET_ACCESS_KEY=

# ---- Email (SMTP relay, mis. Brevo / Resend / Mailjet tier gratis) ----
# Port 587 (STARTTLS) atau 465 (TLS). Domain pengirim wajib diverifikasi di provider (SPF + DKIM + DMARC).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Exapay <no-reply@contoh.co.id>"

# ---- AI (Claude) — wajib di production ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# ---- Kalender kepatuhan (worker) ----
COMPLIANCE_CRON="0 7 * * *"
COMPLIANCE_CRON_TZ=Asia/Jakarta
# Pengingat langganan (feature 40): email trial H-7/H-3/H-1, masa tenggang, baca-saja ke owner
BILLING_NOTICE_CRON="0 7 * * *"
BILLING_NOTICE_CRON_TZ=Asia/Jakarta
# Selfie absen (feature 45): penghapusan harian foto > 90 hari
SELFIE_RETENTION_CRON="30 2 * * *"
SELFIE_RETENTION_CRON_TZ=Asia/Jakarta

# ---- Tagihan & pembayaran QRIS (feature 41) ----
# Isi QR QRIS statik merchant (teks hasil scan QR yang dicetak, diawali 000201) — api
QRIS_STATIC_PAYLOAD=
# Email pemilik platform untuk pemberitahuan "Saya sudah bayar" (wajib; pisahkan dengan koma) — worker
BILLING_NOTIFY_EMAIL=

# ---- Backup (restic → S3 eksternal, terenkripsi di sisi VPS) ----
# Cloudflare R2: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>   (region: auto)
# Backblaze B2 (S3 API): s3:https://s3.<region>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Kunci API bucket backup (batasi ke bucket itu saja, izin baca+tulis)
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
# Jadwal (cron 5 kolom) & zona waktunya — default 02:30 WIB setiap hari
BACKUP_CRON="30 2 * * *"
BACKUP_TZ=Asia/Jakarta
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Opsional: URL ping healthchecks.io (atau sejenis) — alarm jika backup tidak jalan / gagal
BACKUP_HEALTHCHECK_URL=

# ---- Analitik halaman publik — Umami self-hosted (opsional, docker-compose.analytics.yml) ----
# Secret: openssl rand -hex 32. Kosongkan semua bila tidak memakai analitik.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_2FA_KEY=
# Diisi SETELAH membuat website di dashboard Umami (Settings › Websites › tombol kode pelacak):
# UMAMI_SCRIPT_URL=https://stats.contoh.co.id/exa.js  ·  UMAMI_WEBSITE_ID=<uuid website>
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
