# ---- Database (PostgreSQL) ----
# Role runtime (bukan owner tabel, agar RLS berlaku)
DATABASE_URL=
# Role owner, hanya untuk menjalankan migration
DATABASE_MIGRATION_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- Redis (BullMQ) ----
REDIS_URL=

# ---- Auth (NestJS) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Enkripsi kolom sensitif (NIK, NPWP, rekening) ----
DATA_ENCRYPTION_KEY=

# ---- Storage S3-compatible (self-hosted) ----
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Email (SMTP; dev: Mailpit) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- AI (Claude) ----
ANTHROPIC_API_KEY=

# ---- Web (Next.js) ----
# URL API NestJS yang dipanggil dari server Next.js
API_INTERNAL_URL=
# URL publik API (hanya jika dipanggil langsung dari browser)
NEXT_PUBLIC_API_URL=
