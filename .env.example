# Salin ke .env lalu isi. Nilai host (localhost) dipakai saat `pnpm dev` di mesin lokal;
# docker-compose.yml menimpa URL service agar memakai hostname container.

# ---- Umum ----
NODE_ENV=development
API_PORT=4000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=exapayroll
# Password role yang dibuat docker/postgres/init/01-roles.sh
APP_OWNER_PASSWORD=
APP_USER_PASSWORD=
# Role runtime (bukan owner tabel, agar RLS berlaku)
DATABASE_URL=postgres://app_user:<APP_USER_PASSWORD>@localhost:5432/exapayroll
# Role owner, hanya untuk menjalankan migration
DATABASE_MIGRATION_URL=postgres://app_owner:<APP_OWNER_PASSWORD>@localhost:5432/exapayroll
# Port host (ubah jika bentrok dengan service lokal)
POSTGRES_HOST_PORT=5432

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# ---- Auth (NestJS) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Enkripsi kolom sensitif (NIK, NPWP, rekening) ----
DATA_ENCRYPTION_KEY=

# ---- Storage S3-compatible (SeaweedFS, self-hosted) ----
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=exapay
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- URL publik web (tautan di email) ----
APP_WEB_URL=http://localhost:3000

# ---- Email (SMTP; dev: Mailpit) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Exapay <no-reply@exapay.local>"

# ---- Kalender kepatuhan — apps/worker (email pengingat H-7/H-1 ke owner/admin) ----
# Jadwal cron pemindaian harian + zona waktunya (default 07:00 WIB)
COMPLIANCE_CRON="0 7 * * *"
COMPLIANCE_CRON_TZ=Asia/Jakarta
# Pengingat langganan (feature 40): email trial H-7/H-3/H-1, masa tenggang, baca-saja ke owner
BILLING_NOTICE_CRON="0 7 * * *"
BILLING_NOTICE_CRON_TZ=Asia/Jakarta
# Selfie absen (feature 45): penghapusan harian foto > 90 hari
SELFIE_RETENTION_CRON="30 2 * * *"
SELFIE_RETENTION_CRON_TZ=Asia/Jakarta

# ---- Tagihan & pembayaran QRIS (feature 41) ----
# apps/api: isi QR QRIS STATIK merchant platform (teks hasil scan QR, diawali 000201). Kosong = QR tidak ditampilkan.
# Payload divalidasi saat start (CRC, mata uang IDR). Contoh fiktif untuk dev (TIDAK bisa dibayar):
# QRIS_STATIC_PAYLOAD=00020101021126390013ID.EXAPAY.WWW011893600899000000000151660014ID.CO.QRIS.WWW01189360089900000000010215ID20240000000010303UMI5204581253033605802ID5913EXAPAY CONTOH6008MAKASSAR61059011162070703A0163045BBB
QRIS_STATIC_PAYLOAD=
# apps/worker: email pemilik platform yang diberi tahu saat owner menekan "Saya sudah bayar" (pisahkan dengan koma)
BILLING_NOTIFY_EMAIL=

# ---- AI (Claude) — dipakai apps/worker (ringkasan kinerja KPI) ----
# Kosong = provider AI palsu (development, tanpa biaya). WAJIB diisi di production.
ANTHROPIC_API_KEY=
# Model Claude (ID persis, pakai tanda hubung); default claude-haiku-4-5 — hemat biaya untuk narasi pendek
AI_MODEL=claude-haiku-4-5

# ---- Web (Next.js) ----
# URL API NestJS yang dipanggil dari server Next.js
API_INTERNAL_URL=http://localhost:4000
# URL publik API (hanya jika dipanggil langsung dari browser)
NEXT_PUBLIC_API_URL=
